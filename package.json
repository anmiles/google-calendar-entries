{
	"name": "google-calendar-entries",
	"version": "6.0.7",
	"description": "View and manage google calendar entries",
	"keywords": [
		"google",
		"calendar",
		"events"
	],
	"author": "Anatoliy Oblaukhov",
	"homepage": "https://github.com/anmiles/google-calendar-entries",
	"repository": "github:anmiles/google-calendar-entries",
	"license": "MIT",
	"engines": {
		"node": ">=24.18.0"
	},
	"scripts": {
		"spellcheck": "cspell .",
		"prebuild": "rimraf dist",
		"build": "tsc -p ./tsconfig.build.json",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"test": "jest --verbose",
		"test:coverage": "npm test -- --coverage",
		"test:ci": "npm test -- --ci --coverage",
		"test:watch": "npm test -- --watch",
		"test:watch:coverage": "npm test -- --watch --coverage",
		"test:report:coverage": "nyc report",
		"start": "node ./dist/index.js",
		"create": "node ./dist/create.js",
		"migrate": "node ./dist/migrate.js",
		"login": "node ./dist/login.js"
	},
	"dependencies": {
		"@anmiles/google-api-wrapper": "^19.0.8",
		"@anmiles/logger": "^9.0.0",
		"execa": "^5.1.1",
		"googleapis": "^148.0.0",
		"lodash": "^4.18.1"
	},
	"devDependencies": {
		"@anmiles/eslint-config": "^11.0.0",
		"@anmiles/jest-extensions": "^7.0.0",
		"@anmiles/tsconfig": "^5.0.0",
		"@eslint/compat": "^2.1.1",
		"@eslint/css": "^2.0.0",
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^2.1.0",
		"@eslint/markdown": "^8.0.3",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.25",
		"@types/node": "^26.6.1",
		"@typescript-eslint/eslint-plugin": "^8.70.0",
		"@typescript-eslint/parser": "^8.70.0",
		"cspell": "^10.3.3",
		"eslint": "^9.39.2",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-align-assignments": "^1.1.2",
		"eslint-plugin-i18next": "^6.1.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jest": "^29.16.6",
		"eslint-plugin-n": "^18.3.0",
		"eslint-plugin-promise": "^7.3.0",
		"jest": "^30.5.1",
		"jiti": "^2.7.0",
		"nyc": "^18.0.0",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.12",
		"typescript": "^6.0.3"
	}
}
